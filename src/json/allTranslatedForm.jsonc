{
  // Украина(uk)
  "form_UK": {
    "id": "modalForm",
    "btnCloseAria": "кнопка закриття модального вікна",
    "title": "Реєстрація",
    "steps": ["1", "2", "3"],
    "INPUTS_EXPAMPLE": "Все доступные поля для формы лежат в файле 'allFormInputs.json' - скопируйте нужный обьект, и вставьте его ниже в массив inputs",
    "inputs": [
      {
        "title": "Ім'я *",
        "type": "text",
        "name": "name",
        "placeholder": "Ім'я",
        "dataField": "name",
        "required": true,
        "autocomplete": "name"
      },
      {
        "title": "Телефон *",
        "type": "tel",
        "name": "phone",
        "placeholder": "",
        "dataField": "phone",
        "required": true,
        "autocomplete": "tel"
      },
      {
        "title": "Пошта *",
        "type": "email",
        "name": "email",
        "placeholder": "email@gmail.com",
        "dataField": "email",
        "required": true,
        "autocomplete": "email"
      },
      {
        "title": "Згоден з ",
        "type": "checkbox",
        "name": "agree",
        "dataField": "checkbox",
        "required": true,
        "class": "input-wrap-checkbox",
        "linkSeparator": "та",
        "links": [
          {
            "text": "Політика конфіденційності",
            "href": "https://goit.global/ua/privacy-policy/"
          },
          {
            "text": "Умови користування послугами",
            "href": "https://goit.global/ua/terms-of-use/"
          }
        ]
      }
    ],
    "btnSubmit": "Зареєструватися"
  },
